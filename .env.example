# Address used by the reference HTTP server.
ASCP_ADDR=:8080

# Public origin placed in discovery. Use HTTPS in production.
ASCP_BASE_URL=http://localhost:8080

# Demo only. Replace StaticAuthenticator rather than using this on the Internet.
ASCP_DEMO_TOKEN=ascp-demo-token

# Optional persistent raw 64-byte Ed25519 private key encoded with standard
# base64. Production deployments should use a KMS/HSM signer instead.
ASCP_SIGNING_PRIVATE_KEY_B64=
ASCP_SIGNING_KEY_ID=reference-1
